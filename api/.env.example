# ============================================================================
# Decalove API configuration
#
# Copy to `.env`. Every value below is a default -- the API boots with none of
# them set, using in-memory storage, local asset files, and the scripted
# narrator. That configuration is fully playable; it just isn't AI-written.
# ============================================================================

# --- Application ------------------------------------------------------------
PROJECT_NAME="Decalove AI Backend"
API_PREFIX=/api/v1
# JSON array. Must NOT be ["*"] if you need cookies -- browsers reject a
# wildcard origin combined with credentials.
CORS_ORIGINS=["*"]


# --- Narrative model (OpenRouter) -------------------------------------------
# Leave the key empty to run entirely offline on the scripted narrator.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Must support structured outputs. Check which do:
#   https://openrouter.ai/models?supported_parameters=structured_outputs
# Cheap + fast (default):  google/gemini-3.7-flash
# Best prose:              anthropic/claude-opus-5
OPENROUTER_MODEL=google/gemini-3.7-flash
# Refuses to route to a provider endpoint that would ignore response_format.
OPENROUTER_REQUIRE_PARAMETERS=True
OPENROUTER_TIMEOUT_S=90.0
OPENROUTER_MAX_RETRIES=2
# Optional attribution, shown on openrouter.ai activity.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Decalove


# --- Image generation -------------------------------------------------------
# Off by default: image models cost real money on every uncached scene. With
# this on and no API key, a deterministic placeholder generator stands in, so
# the whole asset pipeline still runs.
IMAGE_GENERATION_ENABLED=False
# "openrouter" uses the cloud API; "sdxl" runs stabilityai/stable-diffusion-xl-base-1.0
# locally on GPU via Hugging Face diffusers + PyTorch (no API key needed for images).
IMAGE_BACKEND=openrouter
# Check which models emit images:
#   https://openrouter.ai/models?output_modalities=image
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576

# --- SDXL local GPU settings (only used when IMAGE_BACKEND=sdxl) ------------
# Requires: NVIDIA GPU, CUDA drivers, and nvidia-container-toolkit (for Docker).
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# Local directory for model weights (relative to api/). Keeps weights inside the
# project instead of ~/.cache/huggingface. Pre-download with: python download_model.py
SDXL_MODEL_DIR=models/sdxl
SDXL_DEVICE=cuda
SDXL_TORCH_DTYPE=float16
SDXL_NUM_INFERENCE_STEPS=30
SDXL_GUIDANCE_SCALE=7.5
SDXL_NEGATIVE_PROMPT=
SDXL_ATTENTION_SLICING=True
SDXL_VAE_TILING=False


# --- Generation behaviour ---------------------------------------------------
# Batches are 20 steps with a decision point at step 10-15 (e.g. step 14/15) to eliminate latency.
STEPS_PER_BATCH=20
# Options offered at each decision point. The validator caps a long list and tops up a
# short one, so the player always gets a real menu.
MIN_CHOICES=3
MAX_CHOICES=5
TEMPERATURE=0.85
MAX_OUTPUT_TOKENS=6000
GENERATION_TIMEOUT_S=120.0
# PRD §24 Rule 4: the most one step may move a single relationship axis.
MAX_RELATIONSHIP_DELTA=5
# Ceiling for long-polling GET /games/{id}/steps/next?wait_ms=...
NEXT_STEP_MAX_WAIT_MS=10000
# Pre-generate a run for each option BEFORE the player picks, so choices resolve
# instantly. Costs one model call per branch and throws all but one away.
# 0 = off. Try 2-3 if latency matters more than spend.
SPECULATIVE_PREFETCH_MAX_BRANCHES=0
# Recent steps replayed into the prompt as immediate context.
HISTORY_STEPS=20
# Delivered steps per story arc (prologue -> first_weeks -> festival -> ...).
STEPS_PER_ARC=60
# Delivered steps the player must pass before the story is allowed to end.
ENDING_MIN_STEPS=300
# Character memories retrieved per generation (PRD §17).
MEMORY_TOP_K=6
# Governs the content boundaries handed to the model (PRD §28).
CONTENT_RATING=teen


# --- Garbage collection -----------------------------------------------------
# Games the player has not continued for this long are deleted, along with their
# character memories. Finished stories are never collected, whatever this says.
SESSION_TTL_DAYS=7
SESSION_GC_ENABLED=True
SESSION_GC_INTERVAL_MINUTES=60
SESSION_GC_BATCH_LIMIT=200


# --- Storage ----------------------------------------------------------------
# auto   = use MongoDB if reachable, otherwise in-memory (with a loud warning)
# mongo  = require MongoDB; fail startup if it is down
# memory = never touch MongoDB (saves do not survive a restart)
STORAGE_BACKEND=auto
MONGODB_URL=mongodb://root:rootpassword@localhost:27017
MONGODB_DB_NAME=decalove_db
# How long to wait when probing MongoDB at startup.
STORAGE_PROBE_TIMEOUT_MS=1500


# --- Asset storage ----------------------------------------------------------
# auto = use MinIO if reachable, otherwise the local filesystem
ASSET_BACKEND=auto
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET_NAME=decalove-assets
# Relative paths resolve against the api/ directory.
LOCAL_ASSET_DIR=var/assets


# --- Memory embeddings ------------------------------------------------------
# hashing = deterministic hashed n-grams, no key, no network (default)
# http    = any OpenAI-compatible POST {base_url}/embeddings
# OpenRouter has no embeddings endpoint, which is why "hashing" is the default.
EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSIONS=256
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
