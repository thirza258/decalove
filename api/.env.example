# ============================================================================
# Decalove API configuration
#
# Copy to `.env`. Every value below is a default -- the API boots with none of
# them set, using in-memory storage, local asset files, and the scripted
# narrator. That configuration is fully playable; it just isn't AI-written.
# ============================================================================

# --- Application ------------------------------------------------------------
PROJECT_NAME="Decalove AI Backend"
API_PREFIX=/api/v1
# JSON array. Must NOT be ["*"] if you need cookies -- browsers reject a
# wildcard origin combined with credentials.
CORS_ORIGINS=["*"]
# Published port on the host when running the API with Docker (default: 8000).
# Also accepted: API_PORT, PORT.
DECALOVE_API_PORT=8000

# --- Deployment mode --------------------------------------------------------
# WEB_MODE disables runtime image generation. The API still serves pre-existing
# images from MinIO / local storage and still generates story text with the LLM.
# Story AI failures try OPENROUTER_FALLBACK_MODELS. If every attempt fails, web
# playback pauses with a retry modal; it never silently substitutes scripted prose.
# Set this identically on the API and Celery workers.
# Use this for web deployments where GPU resources are unavailable or where you
# want to strictly control which images are shown.
#   True  = images come only from the asset store, never generated at runtime
#   False = images may be generated on demand via IMAGE_BACKEND (default)
WEB_MODE=False


# --- Narrative model (OpenRouter) -------------------------------------------
# With WEB_MODE=False, leave the key empty to play offline with scripted prose.
# WEB_MODE=True requires a key to continue beyond the authored opening.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free by default. Free model ids change over time; check which support structured
# outputs at:
#   https://openrouter.ai/models?supported_parameters=structured_outputs
# Paid options:  google/gemini-3.7-flash  |  anthropic/claude-opus-5
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Explicit alternates, tried before discovered ones. Leave blank to let the live
# free-model catalogue supply them; configured ids are useful for pinning.
OPENROUTER_FALLBACK_MODELS=
# Discover /models and shuffle free text models into the fallback chain.
# Fail-open: without a catalogue the verified static ids are used.
OPENROUTER_DISCOVER_FREE_MODELS=True
OPENROUTER_MODEL_DISCOVERY_TIMEOUT_S=5
OPENROUTER_FALLBACK_MODEL_LIMIT=2
# Per-model ceiling, including HTTP retries and JSON repair. Automatically reduced
# when necessary so every model fits within GENERATION_TIMEOUT_S.
WEB_AI_ATTEMPT_TIMEOUT_S=120
# Refuses to route to a provider endpoint that would ignore response_format.
OPENROUTER_REQUIRE_PARAMETERS=True
OPENROUTER_TIMEOUT_S=180.0
OPENROUTER_MAX_RETRIES=2
# Optional attribution, shown on openrouter.ai activity.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Decalove


# --- Image generation -------------------------------------------------------
# Off by default: image models cost real money on every uncached scene. With
# this on and no API key, a deterministic placeholder generator stands in, so
# the whole asset pipeline still runs.
IMAGE_GENERATION_ENABLED=False
# An ordered preference chain, comma-separated. The first backend that returns an
# image wins, so a later entry is a fallback rather than an alternative.
#   openrouter  - the cloud API (needs OPENROUTER_API_KEY)
#   sdxl        - stabilityai/stable-diffusion-xl-base-1.0, locally on GPU via
#                 diffusers + PyTorch (no API key needed). In Docker this needs the
#                 GPU overlay below: the default image carries no torch at all, and
#                 'sdxl' is dropped from the chain at boot, with a warning, when it
#                 is missing. A chain like sdxl,openrouter then simply serves from
#                 openrouter instead of failing.
#   placeholder - deterministic offline stand-in; never fails, so it only makes
#                 sense last
# A single name is a chain of one. Examples:
#   IMAGE_BACKEND=openrouter          the API, no GPU required
#   IMAGE_BACKEND=sdxl                the local GPU only
#   IMAGE_BACKEND=sdxl,openrouter     the GPU, falling back to the API when it is
#                                     missing, out of memory, or failing
# An unknown name fails the process at boot rather than silently producing no art.
IMAGE_BACKEND=openrouter
# Docker only, and the other half of choosing "sdxl": no GPU is reserved by default so
# the stack starts on any host. Uncomment to have `docker compose up -d` include the GPU
# overlay. Separator is ":" on Linux/macOS, ";" on Windows.
#
# The overlay is also what builds the image worker from Dockerfile.gpu, which is the only
# image with PyTorch in it. Leave this commented out and nothing in the stack downloads
# or stores the CUDA payload -- which is what a WEB_MODE deployment wants, since it never
# generates a picture at runtime.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Check which models emit images:
#   https://openrouter.ai/models?output_modalities=image
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
# What fraction of *uncached* scenes get new art. Cached art is always reused, whatever
# this says, so the story keeps its look while staying mostly text. Rolled before the job
# is queued, so a scene that loses the roll never reaches the image worker at all.
IMAGE_GENERATION_PROBABILITY=0.05


# --- Visual consistency -----------------------------------------------------
# Making the same character look like the same person is mostly a matter of asking for
# the same picture: identical prompt, identical starting noise, and as few distinct
# images per character as the story can get away with.
#
# Derive each image's seed from *what it is of* (the character, the location) instead of
# letting the sampler pick. Every picture of Aiko then starts from the same noise, which
# is the single biggest lever on whether she is one recognisable person. Backends with no
# seed control ignore it; SDXL honours it.
IMAGE_DETERMINISTIC_SEED=True
# Changes every derived seed at once: a new cast, same prompts. The only way to reroll a
# look you dislike without editing prompts. Any string.
IMAGE_SEED_SALT=
# Appended to every prompt so sprites and backgrounds share one art direction.
# Empty uses the world's own art_style.
IMAGE_STYLE_PROMPT=
# Suppressed in every image. These are consistency terms, not taste: extra figures and
# mismatched faces are what make a cast look like different people. Kind-specific terms
# (sprites suppress scenery, backgrounds suppress people) are added automatically.
# Honoured by SDXL; the hosted image API has no negative field and ignores it.
IMAGE_NEGATIVE_PROMPT=multiple people, crowd, extra faces, extra limbs, deformed hands, inconsistent style, watermark, signature, text, blurry, lowres
# Re-draw a sprite for the place and hour it appears in. Off by design: the sprite is
# background-removed and composited over separately generated scenery, so scene context is
# discarded *after* it has re-lit and re-framed the character. It also multiplies the
# sprite set by every location and time of day. True is legacy, not a supported mode.
IMAGE_CHARACTER_SCENE_CONTEXT=False
# Let the writer vary a sprite's pose, from a closed set. Off keeps it to one image per
# character per expression -- the smallest and steadiest sprite set.
IMAGE_CHARACTER_POSE_VARIANTS=False

# --- SDXL local GPU settings (only used when IMAGE_BACKEND includes sdxl) ---
# Requires: NVIDIA GPU, CUDA drivers, and nvidia-container-toolkit (for Docker), plus
# the COMPOSE_FILE line above -- without it the image has no torch and 'sdxl' is dropped.
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# Local directory for model weights (relative to api/). Keeps weights inside the
# project instead of ~/.cache/huggingface. Pre-download with: python download_model.py
SDXL_MODEL_DIR=models/sdxl
# A requirement, not a preference: asking for "cuda" on a host without it fails this
# backend rather than rendering on the CPU, which is minutes per image and looks exactly
# like a hang. Failing is what hands the request to the next entry in IMAGE_BACKEND.
# Set "cpu" to ask for CPU rendering deliberately.
SDXL_DEVICE=cuda
SDXL_TORCH_DTYPE=float16
SDXL_NUM_INFERENCE_STEPS=30
SDXL_GUIDANCE_SCALE=7.5
SDXL_NEGATIVE_PROMPT=
SDXL_ATTENTION_SLICING=True
SDXL_VAE_TILING=False


# --- Self-hosted web client -------------------------------------------------
# The browser build of the game (../frontend), served by the `web` service in
# docker-compose.yml. It proxies /api/ to the API on the compose network, so the
# browser sees a single origin and CORS_ORIGINS above never comes into it.
# Only relevant when running the stack with Docker.
DECALOVE_WEB_PORT=3000
# Internal nginx port inside the container (default: 80).
# DECALOVE_PORT=80

# --- Docker infrastructure host ports (optional) ----------------------------
# Customize published host ports if defaults conflict with existing host services.
# MONGODB_PORT=27017
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# REDIS_PORT=6379


# --- Background work --------------------------------------------------------
# asyncio = in-process tasks, no extra services, fine for a single node (default)
# celery  = hand work to Redis-backed workers; what docker-compose.yml runs
TASK_QUEUE_BACKEND=asyncio
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Under celery the two workloads are routed to separate queues and consumed by separate
# workers, because a GPU pass must never sit in front of a player's next line:
#
#   celery -A app.tasks.celery_app.celery_app worker -Q story  --concurrency=4
#   celery -A app.tasks.celery_app.celery_app worker -Q images --concurrency=1
#
# A worker started with no -Q consumes both, which puts the blocking back.


# --- Generation behaviour ---------------------------------------------------
# Batches are 20 steps with a decision point at step 10-15 (e.g. step 14/15) to eliminate latency.
STEPS_PER_BATCH=20
# Options offered at each decision point. The validator caps a long list and tops up a
# short one, so the player always gets a real menu.
MIN_CHOICES=3
MAX_CHOICES=5
# How much the writer improvises. Lower is steadier prose, more predictable pacing and
# more reliable structured output; higher is more surprising and more variable. This is
# the text-side counterpart to the image settings above.
TEMPERATURE=0.85
MAX_OUTPUT_TOKENS=6000
GENERATION_TIMEOUT_S=360.0
# PRD §24 Rule 4: the most one step may move a single relationship axis.
MAX_RELATIONSHIP_DELTA=5
# Ceiling for long-polling GET /games/{id}/steps/next?wait_ms=...
NEXT_STEP_MAX_WAIT_MS=10000
# Pre-generate a run for each option BEFORE the player picks, so choices resolve
# instantly. Costs one model call per branch and throws all but one away.
# 0 = off. Try 2-3 if latency matters more than spend.
SPECULATIVE_PREFETCH_MAX_BRANCHES=0
# Recent steps replayed into the prompt as immediate context.
HISTORY_STEPS=20
# Delivered steps per story arc (prologue -> first_weeks -> festival -> ...).
STEPS_PER_ARC=60
# Delivered steps the player must pass before the story is allowed to end.
ENDING_MIN_STEPS=300
# Character memories retrieved per generation (PRD §17).
MEMORY_TOP_K=6
# Governs the content boundaries handed to the model (PRD §28).
CONTENT_RATING=teen


# --- Garbage collection -----------------------------------------------------
# Games the player has not continued for this long are deleted, along with their
# character memories. Finished stories are never collected, whatever this says.
SESSION_TTL_DAYS=7
SESSION_GC_ENABLED=True
SESSION_GC_INTERVAL_MINUTES=60
SESSION_GC_BATCH_LIMIT=200


# --- Storage ----------------------------------------------------------------
# auto   = use MongoDB if reachable, otherwise in-memory (with a loud warning)
# mongo  = require MongoDB; fail startup if it is down
# memory = never touch MongoDB (saves do not survive a restart)
STORAGE_BACKEND=auto
MONGODB_URL=mongodb://root:rootpassword@localhost:27017
MONGODB_DB_NAME=decalove_db
# Docker only. These seed the mongodb container AND build the MONGODB_URL the API is
# given inside compose, so one edit moves both and they cannot drift apart. Outside
# Docker they are unused -- MONGODB_URL above is the whole setting.
#
# Two things to know before changing them:
#   * MONGO_INITDB_* is read only when the data directory is empty. Against an existing
#     `mongodb_data` volume a new password is silently ignored and the API then fails
#     to authenticate. Change it with the volume, or rotate the user in mongosh.
#   * The value is pasted into a URL, so percent-encode @ : / ? # [ ] in a password.
# MONGODB_ROOT_USERNAME=root
# MONGODB_ROOT_PASSWORD=rootpassword
# How long to wait when probing MongoDB at startup.
STORAGE_PROBE_TIMEOUT_MS=1500


# --- Asset storage ----------------------------------------------------------
# auto = use MinIO if reachable, otherwise the local filesystem
ASSET_BACKEND=auto
MINIO_ENDPOINT=localhost:9000
# In Docker these two also seed the minio container's root credentials, so this is the
# one place the pair is written and the server and the client can never disagree.
# Unlike Mongo above, MinIO reads them on every start, so changing them here is enough.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET_NAME=decalove-assets
# Relative paths resolve against the api/ directory.
LOCAL_ASSET_DIR=var/assets


# --- Memory embeddings ------------------------------------------------------
# hashing = deterministic hashed n-grams, no key, no network (default)
# http    = any OpenAI-compatible POST {base_url}/embeddings
# OpenRouter has no embeddings endpoint, which is why "hashing" is the default.
EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSIONS=256
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small


# --- Character intelligence --------------------------------------------------
# Hybrid memory retrieval weights (normalised at use). Tune against playtests.
MEMORY_WEIGHT_SEMANTIC=0.35
MEMORY_WEIGHT_IMPORTANCE=0.20
MEMORY_WEIGHT_RECENCY=0.15
MEMORY_WEIGHT_RELATIONSHIP=0.20
MEMORY_WEIGHT_UNRESOLVED=0.10
# Memory context budget, in approximate tokens (len(text)/4).
MEMORY_CONTEXT_BUDGET=1200
MEMORY_CONSOLIDATION_ENABLED=True
# Character-specific knowledge boundaries, derived from delivered steps.
KNOWLEDGE_ENABLED=True
# Derived narrative threads (promises, conflicts, mysteries).
THREAD_TRACKING_ENABLED=True
# Evidence-based player behaviour profile, committed with the save.
BEHAVIOR_MODELING_ENABLED=True
# Total character budget for the assembled narrative context.
CONTEXT_MAX_CHARS=24000
# Quality evaluation is a second opinion, never a gate: the Validator still runs first.
# The default rubric is deterministic and offline; every run is scored and the report is
# persisted with the batch, with at most QUALITY_MAX_REPAIRS re-validated repairs.
QUALITY_EVALUATION_ENABLED=True
QUALITY_MIN_OVERALL=0.62
QUALITY_MAX_REPAIRS=1
# One trace row per generation attempt (prompt version, context ids, validator result,
# quality, latency, commit/delivery status). Diagnostic only.
NARRATIVE_TRACE_ENABLED=True
# Optional model judge layered over the deterministic rubric. Runs on its own (free)
# model rather than the story model; keep off unless writing quality is being tuned.
QUALITY_JUDGE_ENABLED=False
QUALITY_JUDGE_MODEL=nvidia/nemotron-3.5-super-vl:free
QUALITY_JUDGE_TIMEOUT_S=45
# One bounded writer call to replace a menu whose options are paraphrases.
QUALITY_CHOICE_REPAIR_ENABLED=True
QUALITY_CHOICE_REPAIR_TIMEOUT_S=45
