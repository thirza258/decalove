# Decalove web client.
#
# The API must be reachable from the browser, so this is a URL the *browser*
# resolves -- not a Docker service name. With the stack from api/docker-compose.yml
# that is the published port on the host.
#
# Serve the client and the API over the same scheme: a browser blocks a https page
# calling a http API, whatever CORS says. (The API sends `access-control-allow-origin: *`,
# so a different port is fine.)
VITE_API_BASE=http://localhost:8000
VITE_API_PREFIX=/api/v1

# --- Self-hosting -----------------------------------------------------------
# The two above are BUILD-time settings, used by `npm run dev` and `npm run build`.
# A container ignores them: it writes /config.js from its own environment at start-up,
# so one image runs in every environment. Those variables are:
#
#   DECALOVE_API_BASE       where the *browser* sends API calls. Empty (the default)
#                           means same-origin -- calls go to /api/ on the web server and
#                           nginx proxies them on, which removes CORS and the
#                           http/https mismatch in one move. An absolute URL makes the
#                           browser reach the API directly and leaves the proxy unused.
#   DECALOVE_API_PREFIX     default /api/v1
#   DECALOVE_API_UPSTREAM   where *the web server* forwards /api/. Default http://api:8000,
#                           the service name on the compose network.
#   DECALOVE_PORT           the port nginx listens on inside the container. Default 80.
#
# With api/docker-compose.yml these are already set; DECALOVE_WEB_PORT (default 3000)
# chooses the port the game is published on. Standalone:
#
#   docker compose up -d
#   # or with docker directly:
#   docker build -t decalove-web frontend/
#   docker run -p 3000:80 -e DECALOVE_API_BASE=https://api.example.com decalove-web
